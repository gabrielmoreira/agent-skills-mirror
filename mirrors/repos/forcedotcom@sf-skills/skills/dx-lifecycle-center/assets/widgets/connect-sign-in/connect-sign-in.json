{
  "definition": "tile/widget",
  "children": [
    {
      "definition": "tile/container",
      "attributes": {
        "id": "dx-lifecycle-center--connect-sign-in--v1",
        "label": "Lifecycle Center connection"
      },
      "children": [
        {
          "definition": "tile/text",
          "attributes": {
            "text": "Sign in to Lifecycle Center",
            "variant": "h3"
          }
        },
        {
          "definition": "tile/spacer",
          "attributes": {
            "size": "sm"
          }
        },
        {
          "definition": "tile/text",
          "attributes": {
            "text": "Sign in to your Lifecycle Center org as a user with the DevOps Center User permission set, allow access, and confirm access when your working org asks. Then come back here and reply done."
          }
        },
        {
          "definition": "tile/spacer",
          "attributes": {
            "size": "md"
          }
        },
        {
          "definition": "tile/button",
          "attributes": {
            "label": "Connect to Lifecycle Center org",
            "variant": "primary",
            "actions": {
              "click": [
                {
                  "definition": "action/openLink",
                  "attributes": {
                    "url": "{!$attrs.signInUrl}",
                    "target": "_blank"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
