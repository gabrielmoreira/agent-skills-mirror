{
  "definition": "tile/widget",
  "children": [
    {
      "definition": "tile/container",
      "attributes": {
        "id": "dx-lifecycle-center--connect-connected--v1",
        "label": "Lifecycle Center connection"
      },
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "sm"
          },
          "children": [
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm",
                "align": "center",
                "isWrapped": true
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Connected to Lifecycle Center",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "Connected",
                    "variant": "success"
                  }
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "Lifecycle Center org: {!$attrs.hubHost}",
                "variant": "caption",
                "color": "muted"
              }
            },
            {
              "definition": "tile/text",
              "meta": {
                "if": "{!$attrs.hasHubType}"
              },
              "attributes": {
                "text": "Hub type: {!$attrs.hubTypeLabel}",
                "variant": "caption",
                "color": "muted"
              }
            }
          ]
        }
      ]
    }
  ]
}
