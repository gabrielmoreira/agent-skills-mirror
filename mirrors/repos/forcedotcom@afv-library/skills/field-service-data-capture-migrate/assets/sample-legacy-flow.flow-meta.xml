<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <label>Work Order Completion Form</label>
    <processType>FieldServiceMobile</processType>
    <status>Active</status>

    <!-- Input variables -->
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- Screen 1: Basic Info -->
    <screens>
        <name>Screen_BasicInfo</name>
        <label>Work Completion Details</label>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <fields>
            <name>TechnicianName</name>
            <extensionName>lightning:input</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>type</name>
                <value><stringValue>text</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Technician Name</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>required</name>
                <value><booleanValue>true</booleanValue></value>
            </inputParameters>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>CompletionDate</name>
            <extensionName>lightning:input</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>type</name>
                <value><stringValue>date</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Completion Date</stringValue></value>
            </inputParameters>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>WorkPerformed</name>
            <extensionName>lightning:textarea</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Work Performed</stringValue></value>
            </inputParameters>
            <isRequired>true</isRequired>
        </fields>
        <connector>
            <targetReference>Screen_Status</targetReference>
        </connector>
    </screens>

    <!-- Screen 2: Status -->
    <screens>
        <name>Screen_Status</name>
        <label>Work Status</label>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <fields>
            <name>WorkStatus</name>
            <extensionName>lightning:combobox</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Work Status</stringValue></value>
            </inputParameters>
            <choiceReferences>choice_Completed</choiceReferences>
            <choiceReferences>choice_PartiallyCompleted</choiceReferences>
            <choiceReferences>choice_CannotComplete</choiceReferences>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>FollowUpRequired</name>
            <extensionName>lightning:toggleButton</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Follow-up Required?</stringValue></value>
            </inputParameters>
            <isRequired>false</isRequired>
        </fields>
        <connector>
            <targetReference>Create_WorkOrderHistory</targetReference>
        </connector>
    </screens>

    <!-- Choices -->
    <choices>
        <name>choice_Completed</name>
        <choiceText>Completed</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Completed</stringValue></value>
    </choices>
    <choices>
        <name>choice_PartiallyCompleted</name>
        <choiceText>Partially Completed</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Partially Completed</stringValue></value>
    </choices>
    <choices>
        <name>choice_CannotComplete</name>
        <choiceText>Cannot Complete</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Cannot Complete</stringValue></value>
    </choices>

    <!-- Record Create -->
    <recordCreates>
        <name>Create_WorkOrderHistory</name>
        <label>Create Work Order History</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <inputAssignments>
            <field>WorkOrderId</field>
            <value><elementReference>recordId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Field1</field>
            <value><elementReference>TechnicianName</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Field2</field>
            <value><elementReference>CompletionDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Field3</field>
            <value><elementReference>WorkPerformed</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><elementReference>WorkStatus</elementReference></value>
        </inputAssignments>
        <object>WorkOrderHistory</object>
    </recordCreates>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_BasicInfo</targetReference>
        </connector>
    </start>
</Flow>
